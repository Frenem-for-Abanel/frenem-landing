# frenem-landing Environment Configuration

# Canonical Site & Search Verification
NEXT_PUBLIC_SITE_URL=https://www.frenem.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
INDEXNOW_KEY=

# Contact Form Delivery (SMTP & Webhook)
EMAIL_USER=
EMAIL_PASSWORD=
LEAD_WEBHOOK_URL=

# Observability — Sentry (@sentry/nextjs)
# Railway Healthcheck Path: /api/health
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_GIT_SHA=

# Observability — PostHog (RUM, Web Vitals & Analytics via /ingest rewrite)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
